/* BIOS Simulator - Tema oscuro tipo UEFI */
QMainWindow {
    background-color: #050816;
    color: #e5e7eb;
}

QWidget {
    background-color: transparent;
    color: #e5e7eb;
    font-family: "Consolas", monospace;
}

#header_frame {
    background-color: #0f172a;
    border: 2px solid #3b82f6;
    border-radius: 4px;
    padding: 6px;
}

#center_frame, #right_frame, #log_frame {
    background-color: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 4px;
    padding: 8px;
}

#comp_item {
    background-color: #111827;
    border: 1px solid #1e293b;
    border-radius: 4px;
}

QPushButton {
    background-color: #111827;
    border: 1px solid #3b82f6;
    border-radius: 4px;
    padding: 6px 14px;
    color: #93c5fd;
}

QPushButton:hover {
    background-color: #1e3a8a;
    color: #bfdbfe;
}

QPushButton:disabled {
    border-color: #475569;
    color: #475569;
}

QProgressBar {
    background-color: #111827;
    border: 1px solid #1e293b;
    border-radius: 4px;
    height: 14px;
    text-align: center;
    color: #e5e7eb;
}

QProgressBar::chunk {
    background-color: #2563eb;
    border-radius: 4px;
}